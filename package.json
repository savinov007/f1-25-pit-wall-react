{
  "name": "@deltazeroproduction/f1-udp-parser",
  "version": "1.2.2",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "files": [
    "build"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deltazeroproduction/f1-udp-parser.git"
  },
  "dependencies": {
    "binary-parser": "^1.5.0",
    "struct": "^0.0.12",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/binary-parser": "^1.5.0",
    "@types/jest": "^29.2.5",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.26.0",
    "gts": "^3.1.1",
    "husky": "^8.0.3",
    "jest": "^29.3.1",
    "lint-staged": "^13.1.0",
    "ts-jest": "^29.0.3",
    "typescript": "^4.9.4"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "start": "npm run build && npm run build:web && node server.js",
    "listen": "node listen.js",
    "replay": "node replay.js",
    "replay:dash": "npm run build && npm run build:web && node server.js --replay",
    "recordings:compress": "node scripts/compress-recordings.js",
    "demo": "npm run build && npm run build:web && node server.js --demo",
    "build": "tsc",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "setup": "npm install && npm --prefix web install",
    "build:link": "npm run build && npm link",
    "type-check:watch": "npm run type-check -- --watch",
    "type-check": "tsc --noEmit",
    "check": "gts check",
    "clean": "gts clean",
    "compile": "tsc -p .",
    "fix": "gts fix",
    "test": "node --test \"test/**/*.test.js\" && npm run test:web",
    "prepare": "npm run compile && husky install",
    "pretest": "npm run compile",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"build/**\" --test-coverage-exclude=\"node_modules/**\" \"test/**/*.test.js\"",
    "test:web": "npm --prefix web test"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,css}": [
      "gts fix",
      "git add"
    ]
  },
  "keywords": [
